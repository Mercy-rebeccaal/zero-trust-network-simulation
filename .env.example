# ZERO//TRUST Security Command Center Environment Variables
# Copy this file to .env and adjust variables as needed for your environment.

FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-zero-trust-command-center-secret-key-change-in-production-2026
DATABASE_URI=sqlite:///zero_trust.db

# Security & Session Settings
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_MINUTES=60
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
